<?xml version="1.0" encoding="utf-8"?>
<!-- Settings are backed up; device-specific session recordings are not. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
